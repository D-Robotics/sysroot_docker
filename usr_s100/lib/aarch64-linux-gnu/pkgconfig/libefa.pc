prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: libefa
Description: RDMA Core Userspace Library
URL: https://github.com/linux-rdma/rdma-core
Version: 1.1.39.0
Libs: -L${libdir} -lefa 
Libs.private: 
Requires.private: libibverbs
Cflags: -I${includedir}
