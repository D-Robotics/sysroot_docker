prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include
bindir=${exec_prefix}/bin

Name: GeographicLib
Description: A library for geographic projections
Version: 1.52
URL: https://geographiclib.sourceforge.io

Requires:
Libs: -L${libdir} -lGeographic
Cflags: -I${includedir}
