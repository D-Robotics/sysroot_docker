prefix=/usr
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

toolsdir=${prefix}/bin
orcc=${toolsdir}/orcc

Name: orc-0.4
Description: Library of Optimized Inner Loops Runtime Compiler
Version: 0.4.32
Libs: -L${libdir} -lorc-0.4 -lm -pthread
Cflags: -I${includedir}/orc-0.4 -pthread
