prefix=/usr/lib/aarch64-linux-gnu/pmix2
exec_prefix=${prefix}
libdir=/usr/lib/aarch64-linux-gnu/pmix2/lib
includedir=/usr/lib/aarch64-linux-gnu/pmix2/include

Name: pmix
Description: Process Management Interface for Exascale (PMIx)
Version: 4.1.2
URL: https://pmix.org/
Libs: -L${libdir} -lpmix
Libs.private: -L/usr/lib/aarch64-linux-gnu  -Wl,-rpath -Wl,/usr/lib/aarch64-linux-gnu -Wl,-rpath -Wl,${libdir} -Wl,--enable-new-dtags -levent_core -levent_pthreads -lhwloc
Cflags: -I${includedir}
