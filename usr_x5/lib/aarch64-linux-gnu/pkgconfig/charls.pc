prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: CharLS
Description: JPEG-LS (ISO/IEC 14495-1 / ITU-T.87) library implementation.
Version: 2.3.4
URL: https://github.com/team-charls/charls/
Cflags: -I${includedir}
Libs: -L${libdir} -lcharls
