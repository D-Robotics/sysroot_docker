Name: libpq
Description: PostgreSQL libpq library
Url: https://www.postgresql.org/
Version: 14.11
Requires: 
Requires.private: libssl libcrypto
Cflags: -I/usr/include/postgresql
Libs: -L/usr/lib/aarch64-linux-gnu -lpq
Libs.private: -L/usr/lib/llvm-14/lib -lpgcommon -lpgport -lgssapi_krb5 -lm -lldap
